{
  "name": "bannergress",
  "version": "2.5.2",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "npm run typecheck && vite build",
    "test": "vitest",
    "preview": "vite preview",
    "lint": "npm run lint:types && eslint . --max-warnings 0",
    "lint:types": "oxlint --type-aware --deny-warnings .",
    "fix": "oxlint --type-aware --fix . && eslint . --fix",
    "stylelint": "stylelint '**/*.{css,scss}' --max-warnings 0",
    "stylelint:fix": "stylelint '**/*.{css,scss}' --fix",
    "prepare": "husky",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit"
  },
  "lint-staged": {
    "*.{css,scss}": "stylelint --fix --quiet",
    "*.{js,jsx,ts,tsx}": "eslint --fix"
  },
  "dependencies": {
    "@fontsource/roboto": "^5.2.9",
    "@react-keycloak/core": "^3.2.0",
    "@react-keycloak/web": "^3.4.0",
    "@react-leaflet/core": "^3.0.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@types/react-beforeunload": "^2.1.0",
    "antd": "^6.6.2",
    "history": "^5.3.0",
    "i18next": "^26.4.2",
    "i18next-resources-to-backend": "^1.2.1",
    "keycloak-js": "^26.2.3",
    "leaflet": "^1.9.4",
    "leaflet-loading": "^0.1.24",
    "leaflet.locatecontrol": "^0.90.1",
    "leaflet.markercluster": "^1.5.3",
    "react": "^19.2.8",
    "react-beforeunload": "^2.7.0",
    "react-dom": "^19.2.8",
    "react-hotkeys-hook": "^5.2.4",
    "react-i18next": "^17.0.13",
    "react-intersection-observer": "^11.0.1",
    "react-leaflet": "^5.0.0",
    "react-leaflet-cluster": "^4.1.3",
    "react-markdown": "^10.1.0",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.1.3",
    "react-transition-group": "^4.4.1",
    "redux": "^5.0.1",
    "redux-persist": "^6.0.0",
    "ua-parser-js": "^2.0.10",
    "underscore": "^1.13.8"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/eslint-parser": "^8.0.1",
    "@types/leaflet": "^1.9.12",
    "@types/leaflet-loading": "^0.1.4",
    "@types/leaflet.markercluster": "^1.5.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-transition-group": "^4.4.1",
    "@types/underscore": "^1.11.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react-swc": "^4.2.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.0",
    "eslint-plugin-prettier": "^5.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.0.3",
    "sass": "^1.80.6",
    "sass-embedded": "^1.80.6",
    "stylelint": "^16.10.0",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": "^24.13.0"
  }
}
